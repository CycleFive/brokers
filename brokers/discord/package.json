{
  "name": "discord-broker",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "description": "Remote MCP server on Cloudflare Workers that brokers a Discord bot without exposing its token",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "broker": {
    "secrets": ["DISCORD_BOT_TOKEN", "DISCORD_CLIENT_SECRET"]
  },
  "dependencies": {
    "broker-core": "*"
  }
}
